# ==============================================================================
#  Influnet — Environment Variables (master template)
# ==============================================================================
#  HOW THIS WORKS
#  --------------
#  Copy this file to a real, gitignored env file and fill in values:
#
#     cp .env.example .env.local              # your machine → local/dev backend
#     cp .env.example .env.staging.local      # local run against STAGING backend
#     cp .env.example .env.production.local   # local run against PROD  (rare!)
#
#  Then start the server with the matching script (see apps/web/package.json):
#
#     npm run dev            → APP_ENV=local      · loads .env.local
#     npm run dev:staging    → APP_ENV=staging    · loads .env.staging.local
#     npm run dev:prod       → APP_ENV=production  · loads .env.production.local
#
#  On boot the server prints a banner showing which APP_ENV is active, which
#  file was loaded, and which secrets are present. That banner is your
#  "what am I running against?" safety check — always read it.
#
#  For the DEPLOYED environments (dev / staging / production) these values are
#  NOT stored in files — they are injected as GitHub Actions secrets and Azure
#  App Service application settings. Never commit a filled-in env file.
# ==============================================================================


# ── Environment selector ──────────────────────────────────────────────────────
# WHICH environment's credentials this process runs against.
# One of: local | dev | staging | production
# This is SEPARATE from NODE_ENV (which Next.js controls: development/production/test).
# The npm scripts set this for you; only override it if you know why.
APP_ENV=local

# Public base URL the app is served from. Used for redirects, emails, OG tags.
#   local      → http://localhost:3000
#   dev        → https://influnet-dev.vercel.app
#   staging    → https://influnet-staging.azurewebsites.net
#   production → https://influnet.io
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Supabase ──────────────────────────────────────────────────────────────────
# IMPORTANT: use a SEPARATE Supabase project per environment. Never point
# staging or local at the production database.
#
# Public URL of your Supabase project (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Same URL, read server-side (some server code reads SUPABASE_URL). Keep in sync.
# For production, use the transaction-mode connection pooler port (6543)
# instead of the direct port (5432) to avoid exhausting database connections
# from serverless/edge functions. Example:
#   SUPABASE_URL=https://your-project-ref.pooler.supabase.co:6543
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key — public, scoped to RLS-enforced queries.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key — SERVER-ONLY, full DB access, bypasses RLS.
# NEVER expose to the client, never prefix with NEXT_PUBLIC_.
# NOTE: this must be the service_role JWT (starts with "eyJ..."), NOT a
# personal access token (starts with "sbp_...").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ── Stream Chat (GetStream) ───────────────────────────────────────────────────
# Stream API key — safe to expose in the browser (initializes the client).
NEXT_PUBLIC_STREAM_API_KEY=your-stream-api-key-here

# Same key, read by the server SDK.
STREAM_API_KEY=your-stream-api-key-here

# Stream API secret — SERVER-ONLY, signs user tokens. NEVER expose to client.
STREAM_API_SECRET=your-stream-api-secret-here


# ── Mobile-number OTP (2Factor) ───────────────────────────────────────────────
# "true" requires every new signup to verify their mobile with an SMS OTP.
#
# There is deliberately NO provider key here. TWOFACTOR_API_KEY is a Supabase
# Edge Function secret, set once with:
#   npx supabase secrets set TWOFACTOR_API_KEY=... --project-ref <ref>
#   npx supabase functions deploy phone-otp --project-ref <ref>
#
# Turn this on only AFTER that function is deployed — otherwise the signup gate
# rejects everyone. See docs/operations/PHONE_OTP.md.
NEXT_PUBLIC_PHONE_OTP_ENABLED=false


# ── Email (Resend) ────────────────────────────────────────────────────────────
# Resend API key for transactional email (collab request/accept notifications).
# Leave empty to skip email in local/dev.
RESEND_API_KEY=re_your-resend-api-key-here

# From address for outbound email (must be a verified sender in Resend).
EMAIL_FROM=Influnet <noreply@influnet.io>

# Master switch: "true" actually sends email, "false" suppresses all sends.
# Keep "false" in local/dev/staging; "true" only in production.
NOTIFY_EMAILS_ENABLED=false


# ── Observability (added with the CI/CD + monitoring work) ────────────────────
# Sentry DSN for error tracking. Leave empty to disable Sentry locally.
# Safe to expose (it's a write-only ingest endpoint).
NEXT_PUBLIC_SENTRY_DSN=

# Sentry environment tag — usually mirrors APP_ENV. Auto-derived if empty.
# SENTRY_ENVIRONMENT=


# ── Verification (live Instagram data) ────────────────────────────────────────
# Used to auto-verify creators/businesses (real follower count, Instagram's own
# verified flag, post recency). SERVER-ONLY — never prefix with NEXT_PUBLIC.
# If NEITHER provider is set, verification still works but uses structural
# signals only and escalates everything to a human reviewer.
#
# Provider selection: leave VERIFICATION_PROVIDER unset to auto-pick (prefers
# Apify when APIFY_TOKEN is present), or pin it to 'apify' | 'hikerapi'.
# VERIFICATION_PROVIDER=apify
#
# Apify (default; has free credit, ~$2.60/1000 profiles). Token from
# https://console.apify.com/settings/integrations . Note: ~15s per call, so the
# verification route runs with an extended maxDuration.
APIFY_TOKEN=
#
# HikerAPI (alternative; faster direct API, needs account balance or every call
# returns HTTP 402). Get the key at https://hikerapi.com .
HIKERAPI_ACCESS_KEY=
# Optional override; defaults to https://api.hikerapi.com
# HIKERAPI_BASE_URL=


# ── Rate limiting (Upstash Redis, distributed) ────────────────────────────────
# OPTIONAL but STRONGLY recommended in production. Without these, the limiter
# uses an in-process fixed-window counter that is correct only for a single
# instance — on serverless (Vercel/multiple containers) each instance keeps its
# own count, so real limits are looser than configured. Set both to enforce
# shared limits across every instance. Create a free DB at https://upstash.com
# (Redis → REST API) and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Error monitoring (Sentry) ─────────────────────────────────────────────────
# OPTIONAL. When unset, Sentry is completely inert (no network, no overhead).
# Set the DSN to turn on crash/exception reporting. Get it from your Sentry
# project → Settings → Client Keys (DSN). Use the SAME value for both:
#   NEXT_PUBLIC_SENTRY_DSN  → browser (must be public-prefixed)
#   SENTRY_DSN              → server/edge
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=


# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# OPTIONAL. When unset, project payment stages fall back to "record manual
# (off-platform)" mode — no money moves through the platform. Set these to
# enable in-app Razorpay checkout on the advance/final payment gates.
#   NEXT_PUBLIC_RAZORPAY_KEY_ID → browser checkout (public; starts rzp_live_/rzp_test_)
#   RAZORPAY_KEY_ID            → server (same key id)
#   RAZORPAY_KEY_SECRET        → server-only signing secret
#   RAZORPAY_WEBHOOK_SECRET    → server-only; verifies webhook authenticity
# Get these from https://dashboard.razorpay.com → Settings → API Keys / Webhooks.
# RAZORPAY_WEBHOOK_SECRET must be a real generated secret on staging/production —
# placeholder values are rejected there (a public secret means forgeable
# signatures, i.e. anyone can mark a payment captured). See lib/payments/razorpay.ts.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ── Notes ─────────────────────────────────────────────────────────────────────
# • SUPABASE_ACCESS_TOKEN (sbp_...) is a CLI/management token — it does NOT
#   belong in the app runtime. Keep it in your shell profile for `supabase` CLI
#   use only; do not add it here.
# • Anything the browser must read MUST start with NEXT_PUBLIC_. Everything else
#   stays server-only. When in doubt, leave the prefix OFF.
