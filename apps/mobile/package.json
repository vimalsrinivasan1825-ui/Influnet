{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "RNReanimated",
        "RNWorklets",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    },
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "check:push": "node ../../scripts/check-push-tokens.mjs",
    "setup:webhook": "node ../../scripts/setup-stream-webhook.mjs",
    "check:prod-target": "node ../../scripts/check-mobile-production-target.mjs",
    "eas-build-pre-install": "node ../../scripts/check-mobile-production-target.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.6",
    "@expo/ui": "~57.0.21",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@influnet/api": "*",
    "@influnet/core": "*",
    "@influnet/tokens": "*",
    "@influnet/types": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.7",
    "date-fns": "^4.4.0",
    "expo": "~57.0.26",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.25.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.2",
    "semver": "^7.8.5",
    "stream-chat": "^9.50.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
