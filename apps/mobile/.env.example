# Copy to .env.local and fill in. EXPO_PUBLIC_* vars are inlined into the JS
# bundle at build time — never put a service-role key or any secret here.

# Same Supabase project the web app uses.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Origin that serves /api/* — i.e. the deployed web app.
#   simulator against local dev : http://localhost:3000
#   physical device against dev : http://<your-LAN-ip>:3000
#   staging / prod              : https://<deployment-host>
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# GetStream publishable key — chat does not work without it.
# Use the SAME value as NEXT_PUBLIC_STREAM_API_KEY in apps/web/.env.local; the
# web dashboard already ships it to the browser, so it is not a secret. The
# matching STREAM_API_SECRET stays server-side and must never appear here.
EXPO_PUBLIC_STREAM_API_KEY=your-stream-api-key
