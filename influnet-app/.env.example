# Influnet — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any .env* file (they are gitignored).
#
# ── Supabase ──────────────────────────────────────────────────────────────────
# Public URL of your Supabase project (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key — scoped to RLS-enforced queries
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key — server-only, full DB access, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Stream Chat (GetStream) ───────────────────────────────────────────────────
# Stream API key — safe to expose in the browser (used to initialize the client)
NEXT_PUBLIC_STREAM_API_KEY=your-stream-api-key-here

# Stream API key (same value, used server-side by the Stream server SDK)
STREAM_API_KEY=your-stream-api-key-here

# Stream API secret — server-only, used to sign user tokens, NEVER expose to client
STREAM_API_SECRET=your-stream-api-secret-here

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Resend API key for transactional email (collab request/accept notifications)
# Required for Phase 2 email notifications. Leave empty to skip emails in dev.
RESEND_API_KEY=re_your-resend-api-key-here

# From address for outbound emails (must be verified in Resend)
EMAIL_FROM=Influnet <noreply@influnet.io>

# Set to "true" to actually send emails; "false" (default) suppresses all sends
NOTIFY_EMAILS_ENABLED=false

# ── Notes ─────────────────────────────────────────────────────────────────────
# SUPABASE_ACCESS_TOKEN (personal access token) should NOT be in this file.
# The app no longer calls the Supabase Management API at runtime (Task 1.2).
# If you need it for local CLI operations, keep it in your shell profile only.
