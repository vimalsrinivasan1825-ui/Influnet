# E2E harness runtime state — regenerated per run, carries live user ids
tests/e2e/state/

# Database/data dumps — one-off exports from seeding and cleanup scripts.
# They carry personas and account rows; even when the contents are test data,
# a dump in a public repo invites the next real one in. Keep local copies out
# of git; delete them when the work that needed them is done.
*-backup-*.json
*-dump-*.json

# Journey-run artefacts — regenerated by tests/e2e/phase7-freemium-journey.mjs
tests/e2e/screenshots/freemium/

# Store-listing mockup renders and one-off icon exports — regenerated from
# the sources beside them (render-v2.mjs); too heavy to keep in git.
docs/operations/play-store/mockups/out-v2/
/play_store_icon.png
