  "POST /api/event-pass": {
    "summary": "Register for an event and receive an entry pass (landing /join). Closed 2026-11-10: answers 410 for a finished event (lib/public-events.ts).",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "enum": [
                  "silicon-nexus-s2"
                ]
              },
              "name": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "instagram": {
                "type": "string"
              }
            },
            "required": [
              "event",
              "name",
              "phone"
            ]
          }
        }
      }
    },
    "notes": "⚠️ Audit 2026-11-05: re-registering an existing phone returns that person's existing pass code. The event ended 25 Sep 2026; close it (remove from `EVENTS`) or require an OTP.",
    "responses": {
      "200": {
        "description": "Already registered.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean"
                },
                "passCode": {
                  "type": "string",
                  "example": "INF-AB12CD"
                },
                "name": {
                  "type": "string"
                },
                "alreadyRegistered": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "201": {
        "description": "New registration, same body."
      },
      "400": {
        "description": "Validation failed; `field` names the input.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "429": {
        "$ref": "#/components/responses/RateLimited"
      },
      "500": {
        "$ref": "#/components/responses/ServerError"
      }
    }
  },
  "POST /api/event-survey": {
    "summary": "Look up a registration by phone, or submit the pre-event survey.",
    "notes": "Closed 2026-11-10: both actions answer 410 for a finished event (lib/public-events.ts), which is every event today. Audit 2026-11-05 found that `lookup` returns first name, city and Instagram handle for any registered phone number, and `submit` overwrites answers, with no proof the caller owns the number. Put a phone OTP in front before reopening for a new event."
  },
