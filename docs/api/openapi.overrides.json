{
  "GET /api/health": {
    "summary": "Liveness and database reachability for uptime monitors and the deploy smoke test.",
    "responses": {
      "200": {
        "description": "Healthy.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "healthy"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                },
                "database": {
                  "type": "string",
                  "example": "connected"
                }
              }
            }
          }
        }
      },
      "503": {
        "description": "Database unreachable. The error text is never returned."
      }
    }
  },
  "GET /api/auth/config": {
    "summary": "Runtime signup configuration (served at runtime because NEXT_PUBLIC_* is frozen at build time).",
    "responses": {
      "200": {
        "description": "Cached 60s.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "phoneOtpEnabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "phoneOtpEnabled"
              ]
            }
          }
        }
      }
    }
  },
  "GET /api/auth/check-email": {
    "summary": "Whether an email address is free to register.",
    "parameters": [
      {
        "name": "email",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Address to check"
      }
    ],
    "notes": "Calls `check_email_available` with the service-role client; that RPC is not callable with the anon key (migration 201), so this rate limit is the only path.",
    "responses": {
      "200": {
        "description": "Result.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "valid": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "429": {
        "$ref": "#/components/responses/RateLimited"
      },
      "500": {
        "$ref": "#/components/responses/ServerError"
      },
      "503": {
        "description": "Service-role key missing on this deployment.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "GET /api/auth/check-phone": {
    "summary": "Whether a mobile number is free to register.",
    "parameters": [
      {
        "name": "phone",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Indian mobile number"
      }
    ],
    "notes": "Service-role only RPC since migration 201.",
    "responses": {
      "200": {
        "description": "Result.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "valid": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "429": {
        "$ref": "#/components/responses/RateLimited"
      },
      "500": {
        "$ref": "#/components/responses/ServerError"
      },
      "503": {
        "description": "Service-role key missing on this deployment.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "GET /api/auth/check-instagram": {
    "summary": "Whether an Instagram handle is already claimed by an account."
  },
  "GET /api/auth/suggest-username": {
    "summary": "Suggest free usernames from a display name."
  },
  "POST /api/auth/register": {
    "summary": "Create the profile row for a just-signed-up Supabase user (register_profile RPC).",
    "notes": "Validation messages from `register_profile` (e.g. \"Username already taken\") are passed through on purpose so the form can show them."
  },
  "POST /api/auth/pending-registration": {
    "summary": "Store the verified phone token for a signup still waiting on email confirmation.",
    "notes": "Anonymous by design (the user has no session until the email is confirmed). Keyed by the new user id."
  },
  "GET /api/auth/scrape-instagram": {
    "summary": "Signup-time Instagram profile lookup (follower count, avatar) through Apify."
  },
  "GET /api/discover": {
    "summary": "Creator lookup for brands and creators. Returns `{results}`.",
    "parameters": [
      {
        "name": "q",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Search text; only a username lookup resolves"
      },
      {
        "name": "niche",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Niche filter"
      },
      {
        "name": "industry",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Industry filter"
      },
      {
        "name": "location",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Location filter"
      },
      {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Pagination cursor"
      },
      {
        "name": "id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Fetch one profile by id"
      }
    ],
    "responses": {
      "200": {
        "description": "Results — `{ userRole, results, nextCursor }`. Never `data`.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "userRole": {
                  "type": "string"
                },
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "nextCursor": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "401": {
        "$ref": "#/components/responses/Unauthorized"
      },
      "429": {
        "$ref": "#/components/responses/RateLimited"
      },
      "500": {
        "$ref": "#/components/responses/ServerError"
      }
    }
  },
  "GET /api/collabs": {
    "summary": "The caller's collaboration requests, sent and received. Returns `{collabs}`.",
