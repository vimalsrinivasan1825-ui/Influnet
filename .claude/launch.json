{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=apps/web"
      ],
      "port": 3000
    },
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=apps/landing"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "landing-local-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_EVENT_API_URL=http://localhost:3000",
        "npm",
        "run",
        "dev",
        "--workspace=apps/landing"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "web-e2e",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NOTIFY_EMAILS_ENABLED=false",
        "BROADCAST_DRY_RUN=true",
        "CRON_SECRET=e2e-local-secret",
        "npm",
        "run",
        "dev",
        "--workspace=apps/web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-e2e-prod",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NOTIFY_EMAILS_ENABLED=false",
        "BROADCAST_DRY_RUN=true",
        "CRON_SECRET=e2e-local-secret",
        "npm",
        "run",
        "start",
        "--workspace=apps/web"
      ],
      "port": 3100,
      "autoPort": true
    }
  ]
}
